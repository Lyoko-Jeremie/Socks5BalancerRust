{
  "listenHost": "127.0.0.1",
  "listenPort": 5300,
  "traditionTcpRelay": false,
  "bufferSize": 4096,
  "connectTimeout": 1000,
  "firstPacketTimeout": 5000,
  "handshakeTimeout": 3000,
  "logLevel": "debug",
  "upstream": [
    {
      "name": "mockAuth",
      "host": "127.0.0.1",
      "port": 6200,
      "authUser": "alice",
      "authPwd": "secret"
    }
  ],
  "healthCheck": {
    "tcp": { "period": 500, "timeout": 300, "startDelay": 100 },
    "downBackoff": { "initial": 1000, "multiplier": 2.0, "max": 5000, "jitter": 0.1 },
    "probeJitter": 0.1
  }
}

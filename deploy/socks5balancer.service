[Unit]
Description=Socks5BalancerRust - SOCKS5/HTTP 上游负载均衡代理
Documentation=file:/usr/share/doc/socks5balancer/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=balancer
Group=balancer
ExecStart=/usr/local/bin/Socks5BalancerRust -c /etc/socks5balancer/config.json
Restart=on-failure
RestartSec=2s
# 优雅关闭：进程收到 SIGTERM 后取消任务并在 12s 内收尾
KillSignal=SIGTERM
TimeoutStopSec=20s

# 连接数上限（C10K 场景）：systemd 默认 1024，必须提高
LimitNOFILE=131072
LimitNPROC=65536
LimitCORE=0

# mimalloc 低 RSS 策略（10K 连接 ≤100MB 口径，见 docs/12 §3.4）：
# 程序启动时已内置同样的默认值；这里显式设置有两个目的——让选项在 mimalloc 初始化前生效，
# 以及给运维一个统一的覆盖点（要改/关闭时只改这里，不必改代码）。
Environment=MIMALLOC_PURGE_DELAY=0
Environment=MIMALLOC_ARENA_EAGER_COMMIT=0

# 最小权限加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# 允许读取配置、写日志目录
ReadOnlyPaths=/etc/socks5balancer
ReadWritePaths=/var/log/socks5balancer
StateDirectory=socks5balancer
LogsDirectory=socks5balancer

# 若监听 <1024 端口（如 443）才需要；默认 5000 不需要，按需打开
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
